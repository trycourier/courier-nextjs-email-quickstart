# Your Courier API key, from https://app.courier.com/settings/api-keys
# Copy this file to .env.local and paste your key in. Use the key from the
# same environment (Test or Production) where you connected Resend.
COURIER_API_KEY=YOUR_COURIER_API_KEY

# Where `npm run send` delivers the welcome email. Use your own address.
DEMO_EMAIL=YOUR_EMAIL

# The public URL of your app. The password reset link points here.
APP_URL=http://localhost:3000

# Only for the Stripe receipt route. `stripe listen` prints one, or copy your
# webhook endpoint's signing secret from the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
